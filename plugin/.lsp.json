{
  "carrick": {
    "command": "carrick",
    "args": ["lsp", "--stdio", "--hooks-installed"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact"
    },
    "transport": "stdio",
    "diagnostics": true,
    "restartOnCrash": true,
    "startupTimeout": 30000
  }
}
