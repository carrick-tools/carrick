#!/bin/bash
#
# Carrick Pre-Commit Hook
# Runs the formatting check before allowing a commit; clippy and tests run in CI.
#
# This file is the tracked source. `scripts/install-hooks.sh` copies it into
# the repository's hooks directory, which every worktree of the clone shares.
#

set -euo pipefail  # Exit on error and fail pipelines

# Isolate child processes (notably Rust tests that `git init` throwaway repos in
# tempdirs) from the ambient GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE that git
# sets for this hook. Without this a test's `git add .` targets THIS repo's
# index, and inside a linked worktree it corrupts the worktree index mid-commit
# (it produced bogus "delete the whole repo" trees during the eval work).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "🪢 Carrick Pre-Commit Hook"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# The installed hook is a copy, so a change to this file reaches a committer
# only after the installer runs again. Say so when the two differ, without
# telling a feature branch to install its copy: the hooks directory is shared
# by every worktree, so that would replace the hook for all of them.
TRACKED_HOOK="$REPO_ROOT/scripts/hooks/pre-commit"
if [ -f "$TRACKED_HOOK" ] && ! cmp -s "$0" "$TRACKED_HOOK"; then
    echo "ℹ️  The installed hook differs from scripts/hooks/pre-commit in this checkout."
    echo "   Once that change is on main, run ./scripts/install-hooks.sh from a checkout of main."
fi

cd "$REPO_ROOT"

# Check if CARRICK_API_ENDPOINT is set
if [ -z "${CARRICK_API_ENDPOINT:-}" ]; then
    echo "⚠️  CARRICK_API_ENDPOINT not set, using default for testing"
    export CARRICK_API_ENDPOINT="https://test.example.com"
fi

# Run cargo fmt check
echo ""
echo "Checking code formatting..."
echo ""

if ! cargo fmt --check; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "❌ Code formatting issues found! Commit blocked."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "Run 'cargo fmt' to fix formatting issues and try again."
    echo ""
    exit 1
fi

echo "✅ Code formatting looks good!"


# Clippy, the sidecar build and the Rust test suite run in CI, not here
# (David, 2026-10-08). Each one is a full compile on every commit, and with
# several agents committing in parallel worktrees they held the machine at a
# load of 30 to 44. CI's Linting, Build and Rust test jobs run them on every PR
# and again in the merge queue. Run the tests a change affects before you
# push: `cargo test --test <name>`, or `npm test` in src/sidecar.

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ Formatting checked. Clippy and tests run in CI."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

exit 0
