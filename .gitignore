# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

**/*/node_modules
!src/sidecar/test/fixtures/sample-repo/node_modules/
!src/sidecar/test/fixtures/sample-repo/node_modules/wrapper-lib/
!src/sidecar/test/fixtures/sample-repo/node_modules/wrapper-lib/index.d.ts
!src/sidecar/test/fixtures/capture-v2-installed/node_modules/
!src/sidecar/test/fixtures/capture-v2-installed/node_modules/@acme/
!src/sidecar/test/fixtures/capture-v2-installed/node_modules/@acme/models/
!src/sidecar/test/fixtures/capture-v2-installed/node_modules/@acme/models/package.json
!src/sidecar/test/fixtures/capture-v2-installed/node_modules/@acme/models/index.d.ts
**/ts_check/output
mcp-server/dist
mcp-server/dist-lambda

# Lambda build artifacts
lambdas/*.zip

# Terraform state files
*.tfstate
*.tfstate.backup
# Exception: bootstrap state is committed (no secrets, see terraform/bootstrap/README.md)
!terraform/bootstrap/terraform.tfstate

# Crash logs
crash.log

# macOS Finder metadata
.DS_Store

# Terraform CLI working directory
.terraform/

# Variable files (with potential secrets)
*.tfvars
*.tfvars.json

# Decrypted SOPS files — never commit. Encrypted (.enc.yaml) is fine.
*.dec.yaml
secrets.yaml

# Override files (used for local-only config overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan
examples/*/package-lock.json

# Captured scanner output from example runs — never commit
examples/*/output/

# Local git worktrees created under .claude/ — never committed
.claude/worktrees/
.claude/settings.local.json
