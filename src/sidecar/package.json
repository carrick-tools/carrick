{
  "name": "@carrick/type-sidecar",
  "version": "0.1.0",
  "description": "TypeScript type extraction sidecar for carrick",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc && node scripts/write-engine-stamp.mjs",
    "start": "node dist/index.js",
    "test": "node scripts/test-files.mjs run all --",
    "clean": "rm -rf dist",
    "test:coverage": "node scripts/test-files.mjs run all -- --experimental-test-coverage"
  },
  "dependencies": {
    "@ts-morph/common": "0.29.0",
    "ts-morph": "28.0.0",
    "typescript": "6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "pnpm": "10.34.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true
}
