{
  // The published JavaScript. Node refuses to strip types for anything under
  // node_modules, so an installed package cannot ship the .ts files the tests
  // and the checkout run directly — it ships this emit instead.
  // `rewriteRelativeImportExtensions` is what lets the source keep its `.ts`
  // specifiers and the emit resolve to `.js`.
  //
  // Declarations are emitted because a TypeScript consumer imports
  // `carrick/templates`: without them the `types` condition on that export has
  // no file to name, and the import is TS7016 under any strict config
  // (carrick#845).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
