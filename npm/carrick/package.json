{
  "name": "carrick",
  "version": "0.3.137",
  "carrickCache": {
    "cache_version": 22,
    "intent_cache_version": 2
  },
  "carrickInputs": {
    "rule": 1,
    "source_extensions": [
      "ts",
      "tsx",
      "mts",
      "cts",
      "js",
      "jsx",
      "mjs",
      "cjs"
    ],
    "repo_input_names": [
      "package-lock.json",
      "npm-shrinkwrap.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "bun.lock",
      "bun.lockb",
      "deno.lock",
      "package.json",
      "pnpm-workspace.yaml",
      "deno.json",
      "deno.jsonc",
      ".gitignore",
      "carrick.json",
      ".npmrc",
      ".yarnrc",
      ".yarnrc.yml",
      "bunfig.toml",
      ".gitmodules",
      ".gitattributes"
    ],
    "repo_input_extensions": [
      "graphql",
      "gql",
      "graphqls"
    ],
    "config_extensions": [
      "json",
      "jsonc"
    ],
    "derive_names": [
      "netlify.toml",
      "vercel.json",
      "serverless.yml",
      "wrangler.toml",
      "Dockerfile"
    ]
  },
  "description": "Maps your entire TypeScript codebase across services and repositories, giving AI agents full context on existing types, routes, and function behaviours over MCP before they write duplicate or breaking code.",
  "keywords": [
    "typescript",
    "monorepo",
    "api",
    "contracts",
    "lsp",
    "claude-code"
  ],
  "homepage": "https://carrick.tools",
  "bugs": "https://github.com/carrick-tools/carrick/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carrick-tools/carrick.git",
    "directory": "npm/carrick"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "bin": {
    "carrick": "bin/carrick.mjs"
  },
  "exports": {
    "./templates": {
      "types": "./dist/templates.d.ts",
      "default": "./dist/templates.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "dist",
    "plugin",
    "scripts/install-scanned-deps.sh",
    "sidecar",
    "templates",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node node_modules/typescript/bin/tsc --noEmit && npm run build && node --test --import=./test/no-update-check.mjs 'test/**/*.test.ts'",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "selftest": "node test/selftest.ts",
    "bundle": "node scripts/bundle-sidecar.mjs",
    "prepack": "npm run build && node scripts/bundle-sidecar.mjs && node scripts/bundle-install-script.mjs",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "picocolors": "1.1.1",
    "pnpm": "10.34.5",
    "ts-morph": "28.0.0",
    "typescript": "6.0.2",
    "typescript-native": "npm:typescript@7.0.2",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@carrick-tools/cli-darwin-arm64": "0.3.137",
    "@carrick-tools/cli-darwin-x64": "0.3.137",
    "@carrick-tools/cli-linux-arm64": "0.3.137",
    "@carrick-tools/cli-linux-x64": "0.3.137",
    "@carrick-tools/cli-win32-x64": "0.3.137"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
